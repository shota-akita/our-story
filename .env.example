# Copy this file to .env and replace every sample value before deployment.
# Docker Compose and config.php both read the resulting .env file.
# Never commit .env.

# Storage driver: mysql or dynamodb
DB_DRIVER=mysql

# Local Docker Compose defaults. Use deployment-specific values outside local development.
DB_HOST=db
DB_USER=root
DB_PASSWORD=change-me-local-only
DB_SOCKET=/var/lib/mysql/mysql.sock

# Host port exposed by Docker Compose
WEB_PORT=8080

# Optional display label selector (set to ec2 on EC2)
APP_PLATFORM=

# DynamoDB settings. Prefer an IAM role on AWS; leave static credentials empty when possible.
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DYNAMODB_MEMORIES_TABLE=our-story-memories
DYNAMODB_USERS_TABLE=our-story-users
